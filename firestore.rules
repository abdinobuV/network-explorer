rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function isGuru() {
      return request.auth != null &&
        get(/databases/$(db)/documents/users/$(request.auth.uid)).data.role == "guru";
    }

    match /users/{uid} {
      // Siswa hanya boleh membaca datanya sendiri; Guru boleh membaca data seluruh murid.
      allow read: if request.auth != null && (request.auth.uid == uid || isGuru());
      allow create: if request.auth != null && request.auth.uid == uid;
      // Siswa tidak boleh mengubah perannya sendiri menjadi guru setelah akun dibuat.
      allow update: if request.auth != null && request.auth.uid == uid &&
        (
          !("role" in request.resource.data) ||
          !("role" in resource.data) ||
          request.resource.data.role == resource.data.role
        );
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /leaderboard/{uid} {
      // Papan peringkat ringkas (hanya nama/anonim, kelas, XP, level, skor kuis — tanpa email atau data pribadi).
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
