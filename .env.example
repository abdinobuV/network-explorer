# Konfigurasi Firebase untuk aplikasi Network Explorer.
# Ganti nilai di bawah sesuai proyek Firebase milikmu (Firebase Console > Project settings > General).
# Jangan pernah meng-commit .env.local yang berisi nilai asli.
#
# Semua variabel di sini memakai prefix NEXT_PUBLIC_ karena dipakai di sisi klien.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Set ke "1" untuk menjalankan aplikasi tanpa Firebase (akun demo lokal, data disimpan di localStorage).
# Kosongkan untuk memakai Firebase sungguhan.
NEXT_PUBLIC_DEMO_MODE=
